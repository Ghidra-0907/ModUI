<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/launcherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gemini_default_dark">

    <!-- Bottom Layer A: Static / GIF Wallpaper (rendered smoothly by Coil + Coil-GIF) -->
    <ImageView
        android:id="@+id/ivBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:visibility="gone" />

    <!-- Bottom Layer B: 60fps Video Wallpaper (TextureView + MediaPlayer, zero WebView CPU overhead) -->
    <TextureView
        android:id="@+id/tvVideoBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Middle Layer: Dim Overlay View to keep white text crisp -->
    <View
        android:id="@+id/viewDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.35"
        android:background="#000000"
        android:visibility="gone" />

    <!-- Top Layer: Transparent Hardware-Accelerated WebView inside Safe Insets -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />
    </FrameLayout>

    <!-- Subtle top page-load indicator -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:max="100"
        android:visibility="gone"
        app:indicatorColor="@color/accent_primary"
        app:trackColor="@android:color/transparent"
        app:trackThickness="2.5dp" />

</FrameLayout>
